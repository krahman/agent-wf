# Copy to .env and fill in. Empty values are treated as unset.
# Read by the app (agent_wf/config.py) and by `docker compose` (env_file + ${...} substitution).

# --- LLM (required) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
# LLM_TIMEOUT=60                 # seconds
# AGENT_RECURSION_LIMIT=15       # max agent loop steps per request

# --- App ---
# LOG_LEVEL=INFO
# GIT_SHA=unknown                # set at image build time, shown by GET /

# --- Langfuse tracing (off by default) ---
# `docker compose up` turns tracing on and points the API at the bundled Langfuse for you.
# Set these only when running the API outside compose, e.g. `uv run fastapi dev main.py`.
LANGFUSE_TRACING=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- docker compose overrides (local-dev defaults are used when unset; change before sharing) ---
# LANGFUSE_ADMIN_EMAIL=admin@example.com
# LANGFUSE_ADMIN_PASSWORD=admin12345
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=       # 64 hex characters: openssl rand -hex 32
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
# MINIO_PASSWORD=
# REDIS_PASSWORD=
